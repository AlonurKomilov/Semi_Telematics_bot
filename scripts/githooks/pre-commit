#!/usr/bin/env python3
"""Commit guard — the rules, enforced instead of remembered.

Two AIs and one human share this working tree, and production runs out
of it.  Every rule below exists because breaking it cost real time on
2026-08-07, and every one is checked against the STAGED content, never
the working tree: a guard that stashes or checks out to inspect a
commit can lose the very work it is protecting.

Install once:
    git config core.hooksPath scripts/githooks

Bypass, when you have a reason:
    git commit --no-verify
"""
from __future__ import annotations

import subprocess
import sys

RED, YEL, DIM, OFF = "\033[31m", "\033[33m", "\033[2m", "\033[0m"


def sh(*args: str) -> str:
    return subprocess.run(args, capture_output=True, text=True).stdout


def staged_paths() -> list[str]:
    out = sh("git", "diff", "--cached", "--name-only", "--diff-filter=ACMR")
    return [p for p in out.splitlines() if p.strip()]


def staged_blob(path: str) -> str | None:
    r = subprocess.run(["git", "show", f":{path}"], capture_output=True)
    if r.returncode != 0:
        return None
    try:
        return r.stdout.decode("utf-8")
    except UnicodeDecodeError:
        return None


problems: list[str] = []
warnings: list[str] = []
paths = staged_paths()
py = [p for p in paths if p.endswith(".py")]


# ── Rule 1 — staged Python must parse ────────────────────────────
# A half-saved file reaching the index is not hypothetical here:
# production imports from this tree, so a broken file is served.
import ast

for p in py:
    src = staged_blob(p)
    if src is None:
        continue
    try:
        ast.parse(src, filename=p)
    except SyntaxError as e:
        problems.append(f"{p}:{e.lineno}: syntax error — {e.msg}")


# ── Rule 2 — no undefined names in staged Python ─────────────────
# THE rule.  A NameError killed every group-routed alert for four days
# (_group_text_plain), and an unimported annotation sat red in CI for a
# week (VehicleScope).  tests/test_undefined_names.py already keeps the
# backend at zero findings, so this only moves that feedback from a
# 90-minute suite to the moment you commit.
if py:
    try:
        from pyflakes.api import check
        from pyflakes.reporter import Reporter
        import io

        for p in py:
            src = staged_blob(p)
            if src is None:
                continue
            # Reporter(warningStream, errorStream) — findings land in the
            # WARNING stream; the error stream carries only pyflakes'
            # own failures.  Reading the wrong one silently finds
            # nothing, which is how this rule shipped inert the first
            # time and had to be caught by testing it against a real
            # undefined name.
            warn, err = io.StringIO(), io.StringIO()
            check(src, p, Reporter(warn, err))
            for line in warn.getvalue().splitlines():
                if "undefined name" in line:
                    problems.append(line.strip())
    except ImportError:
        warnings.append("pyflakes missing — undefined-name check skipped")


# ── Rule 5 — a staged file may not import a module the commit removes ──
# The gap rules 1-2 cannot see.  pyflakes reads ONE FILE at a time, so
# `from adapters.storage.object_store import x` is invisible to it even
# when that module is being deleted in the same commit: each file is
# individually valid while the tree as a whole will not import.
#
# That is exactly how a rename shipped with ten importers left behind —
# HEAD could not start for hours, and nothing noticed because production
# serves the working tree, where the fix already existed uncommitted.
#
# Resolved against the tree AS IT WILL BE: HEAD's files, minus what this
# commit deletes, plus what it adds.  Module paths only, never the
# imported NAMES — `from a.b import c` is satisfied by a/b existing,
# because c may legitimately be a name rather than a submodule.
FIRST_PARTY = {"adapters", "capabilities", "features", "infra", "interfaces", "tests"}


def _post_commit_modules() -> set[str]:
    head = set(sh("git", "ls-tree", "-r", "HEAD", "--name-only").splitlines())
    gone = set(sh("git", "diff", "--cached", "--diff-filter=D", "--name-only").splitlines())
    files = (head - gone) | set(paths)
    mods: set[str] = set()
    for f in files:
        if not f.endswith(".py"):
            continue
        parts = f[:-3].split("/")
        if parts[-1] == "__init__":
            parts = parts[:-1]
        if parts and parts[0] in FIRST_PARTY:
            mods.add(".".join(parts))
    return mods


def _optional_imports(tree: ast.AST) -> set[int]:
    """Import nodes guarded by try/except ImportError — legitimately
    absent, so never a violation."""
    exempt: set[int] = set()
    for node in ast.walk(tree):
        if not isinstance(node, ast.Try):
            continue
        names = set()
        for h in node.handlers:
            for n in ast.walk(h.type) if h.type else []:
                if isinstance(n, ast.Name):
                    names.add(n.id)
        if names & {"ImportError", "ModuleNotFoundError", "Exception"}:
            for child in ast.walk(node):
                if isinstance(child, (ast.Import, ast.ImportFrom)):
                    exempt.add(id(child))
    return exempt


if py:
    available = _post_commit_modules()
    for p in py:
        src = staged_blob(p)
        if src is None:
            continue
        try:
            tree = ast.parse(src, filename=p)
        except SyntaxError:
            continue  # already reported by rule 1
        exempt = _optional_imports(tree)
        pkg = p[:-3].split("/")
        if pkg[-1] == "__init__":
            pkg = pkg[:-1]
        for node in ast.walk(tree):
            if id(node) in exempt:
                continue
            targets: list[str] = []
            if isinstance(node, ast.Import):
                targets = [a.name for a in node.names]
            elif isinstance(node, ast.ImportFrom):
                if node.level:                       # relative — resolve it
                    base = pkg[:-node.level] if node.level <= len(pkg) else []
                    targets = [".".join(base + ([node.module] if node.module else []))]
                elif node.module:
                    targets = [node.module]
            for t in targets:
                if not t or t.split(".")[0] not in FIRST_PARTY:
                    continue                          # stdlib / third-party
                if t in available:
                    continue
                # A parent package is enough: `import a.b.c` where c is a
                # name re-exported from a/b/__init__.py.
                if any(t.rsplit(".", i)[0] in available for i in range(1, t.count(".") + 1)):
                    continue
                problems.append(
                    f"{p}:{node.lineno}: imports {t}, which will not exist "
                    f"after this commit"
                )


# ── Rule 5b — you may not delete a module others still import ────
# The half that matters, and the half the obvious implementation
# misses.  Rule 5a inspects STAGED files, but in the incident this was
# built for the importers were not staged at all: the commit deleted
# a module and ten untouched files kept importing it.  Checking only
# what you staged is exactly how that shipped.
#
# So when a commit removes a first-party module, look the other way —
# ask who still imports it in the tree AS IT WILL BE.  `git grep` over
# HEAD is ~0.1s for 885 files; a staged file is re-read from the index,
# because its staged version may already be fixed.
# Everything this commit removes.  `staged_paths()` filters ACMR, so
# deletions are absent from it by design — which made a file the commit
# DELETES read as an importer that survives the commit.  Deleting a
# module together with its own test is the ordinary way to remove a
# feature, and the guard blocked exactly that.
deleted_now = set(
    sh("git", "diff", "--cached", "--diff-filter=D", "--name-only").splitlines()
)
deleted_py = [f for f in deleted_now if f.endswith(".py")]
for f in deleted_py:
    parts = f[:-3].split("/")
    if parts[-1] == "__init__":
        parts = parts[:-1]
    if not parts or parts[0] not in FIRST_PARTY:
        continue
    mod = ".".join(parts)
    if mod in _post_commit_modules():
        continue  # a package still provides it (e.g. only a submodule went)
    hits = sh("git", "grep", "-l", "-e", f"import {mod}", "-e", f"from {mod}",
              "HEAD", "--", "*.py").splitlines()
    for hit in hits:
        path = hit.split(":", 1)[1] if hit.startswith("HEAD:") else hit
        # A file this commit also removes cannot import anything after
        # it — judging it by its HEAD content asks about a tree that
        # will not exist.
        if path == f or path in deleted_now:
            continue
        # Staged files may already be corrected — judge the staged blob.
        if path in paths:
            blob = staged_blob(path) or ""
            if f"import {mod}" not in blob and f"from {mod}" not in blob:
                continue
        problems.append(
            f"{path}: still imports {mod}, which this commit deletes"
        )


# ── Rule 3 — secrets never enter a commit ────────────────────────
SECRET_NAMES = (".env", "id_rsa", "id_ed25519")
SECRET_SUFFIX = (".pem", ".key", ".p12", ".keystore")
for p in paths:
    base = p.rsplit("/", 1)[-1]
    if base in SECRET_NAMES or base.startswith(".env.") or p.endswith(SECRET_SUFFIX):
        problems.append(f"{p}: secret-shaped file staged")


# ── Rule 4 — did you stage somebody else's work? ─────────────────
# The expensive one.  A shared index swept another author's in-flight
# files into the wrong commit three times this week, twice breaking
# main: once the caller shipped without its callee (AttributeError on
# every application submission), once a mid-edit component shipped and
# the dashboard went black.
#
# `git add -A` cannot be detected directly — but its FOOTPRINT can.  In
# a tree two people are editing, staging everything leaves nothing
# behind.  Leftover unstaged work is the normal, healthy state here.
left = [ln for ln in sh("git", "status", "--porcelain").splitlines()
        if ln[:2] not in ("A ", "M ", "D ", "R ") and ln.strip()]
if len(paths) >= 5 and not left:
    warnings.append(
        f"{len(paths)} files staged and NOTHING left unstaged — the shape of "
        "`git add -A` in a shared tree.\n"
        "      If any of these are not yours, reset and stage explicitly:\n"
        "        git reset && git add -- <your files>"
    )


# ── report ────────────────────────────────────────────────────────
if warnings:
    print(f"\n{YEL}  commit guard — warnings{OFF}\n", file=sys.stderr)
    for w in warnings:
        print(f"    ! {w}", file=sys.stderr)

if problems:
    print(f"\n{RED}  commit guard — BLOCKED{OFF}\n", file=sys.stderr)
    for pr in problems:
        print(f"    x {pr}", file=sys.stderr)
    print(
        f"\n{DIM}    These run against the STAGED content, so the working tree\n"
        f"    is untouched — fix, re-stage, commit again.\n"
        f"    Deliberate exception: git commit --no-verify{OFF}\n",
        file=sys.stderr,
    )
    sys.exit(1)

if warnings:
    print(f"{DIM}    (warnings do not block){OFF}\n", file=sys.stderr)
sys.exit(0)
