{
  "manifest_version": 3,
  "name": "4truck",
  "description": "4truck vehicle management in a side panel, beside whatever you are working on.",
  "version": "0.3.1",
  "action": {
    "default_title": "4truck",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://api.4truck.us/*",
    "https://www.google.com/maps/*"
  ],
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "externally_connectable": {
    "matches": [
      "https://*.4truck.us/*",
      "https://4truck.us/*"
    ]
  }
}
