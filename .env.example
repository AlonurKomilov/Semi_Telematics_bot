# ─────────────────────────────────────────────────
#  Semi Telematics Bot — Environment Configuration
# ─────────────────────────────────────────────────
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
#
#  Bot infrastructure ONLY. NO customer data here.
#  All customer accounts, orgs, Samsara API keys,
#  and users are managed via bot commands (/register,
#  /addorg, /invite) and stored in the database.
# ─────────────────────────────────────────────────

# ── Telegram bot tokens ─────────────────────────────────────────
# Two separate bots — never one for both roles:
#
#   TELEGRAM_SYSTEM_BOT_TOKEN — SYSTEM / operator bot.  Runs the
#                               operator-only daemon (/admin family)
#                               on system.4truck.us, validates the
#                               operator Login Widget, sends ops
#                               error reports, and fetches user
#                               profile photos for /admin/users.
#                               Never customer-facing.
#                               BotFather Login Widget domain →
#                               system.4truck.us
#
#   TELEGRAM_LOGIN_BOT_TOKEN  — CUSTOMER front-door bot.  Runs the
#                               long-running PTB daemon
#                               (interfaces/bot/app.py — /start,
#                               /register, /join) AND validates
#                               Telegram Login Widget signatures for
#                               accounts that don't have their own
#                               per-account bot.  Give it customer-
#                               facing branding at @BotFather.
#                               BotFather Login Widget domain →
#                               4truck.us  (the apex is the single
#                               login gate — the SPA's /login route is
#                               served at https://4truck.us/login and
#                               redirects to the persona subdomain
#                               after auth.  One domain per bot is a
#                               Telegram limit, so the apex covers
#                               every persona host.)
#
# Per-account bots (stored encrypted in accounts.bot_token_encrypted)
# are unaffected by this split — each tenant's branded bot remains
# the source of truth for their users and carries all tenant commands.
#
# NOTE: the legacy env name ``TELEGRAM_BOT_TOKEN`` is still accepted as
# a fallback for the system token, but is deprecated — prefer
# TELEGRAM_SYSTEM_BOT_TOKEN.  If TELEGRAM_LOGIN_BOT_TOKEN is unset, the
# customer daemon falls back to the system token with a startup
# warning.

TELEGRAM_SYSTEM_BOT_TOKEN=your_system_operator_bot_token_here
TELEGRAM_LOGIN_BOT_TOKEN=your_customer_facing_bot_token_here

# System Owners — platform administrators (NOT customers)
# Comma-separated Telegram IDs. These users see /admin panel,
# bot-wide analytics, account management. NOT stored in DB.
SYSTEM_OWNER_IDS=123456789

# Support contact — shown to new/unregistered users
SUPPORT_CONTACT=@YourSupportHandle

# Database connection — REQUIRED.
# PostgreSQL is the only supported backend (cutover 2026-05-08).
# adapters/storage/core.py refuses to boot without this set.
#
# Format:  postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://4truck:devpass@localhost:5434/4truck

# Samsara API base URL
SAMSARA_BASE_URL=https://api.samsara.com

# Alert Configuration
# How often (in minutes) to check for new faults and send alerts
ALERT_CHECK_INTERVAL_MINUTES=30

# Fuel level threshold (%) — trucks below this trigger a low-fuel warning
FUEL_LOW_THRESHOLD_PERCENT=20

# Encryption key for API keys at rest.
# Set a strong passphrase. Once set, existing plaintext keys
# in the DB will be encrypted automatically on next startup.
# WARNING: Changing this after encryption will make stored keys unreadable.
ENCRYPTION_KEY=

# ── AI Assistant (optional) ──────────────────────
# Google Generative AI (Gemini) API key.
# Get one at: https://aistudio.google.com/app/apikey
# Leave blank to disable AI features.
GOOGLE_AI_API_KEY=

# Gemini model name (optional — defaults to gemini-2.0-flash)
# Other options: gemini-1.5-pro, gemini-1.5-flash
GOOGLE_AI_MODEL=gemini-2.0-flash

# ── Google Drive — per-account BYOS (OAuth) ───────────────────────
# Each customer connects their OWN Google Drive via OAuth consent.
# Files live in the customer's Drive under "4truck Fleet Data/account-<id>/".
# Scope: drive.file (minimum — only files 4truck creates / user picks).
#
# Setup:
#   1. Google Cloud Console → APIs & Services → Credentials
#   2. Create OAuth 2.0 Client ID (Web application)
#   3. Authorized redirect URIs:
#        https://your-domain.tld/api/storage/google/callback
#   4. Enable "Google Drive API" in APIs & Services → Library
#   5. Paste Client ID + Secret below
GDRIVE_OAUTH_CLIENT_ID=
GDRIVE_OAUTH_CLIENT_SECRET=
# Redirect URI is set under the "Subdomain layout" section below.

# Base URL to redirect the user back to AFTER the OAuth callback runs.
# The callback hits the API host (api.4truck.us — the redirect_uri
# registered with Google), but the success / error banner has to
# appear on the dashboard host (dash.4truck.us, where the SPA lives).
# The redirect path is ``/admin/settings?...``; this var is just the
# scheme + host prefix.
DASHBOARD_BASE_URL=https://dash.4truck.us

# Where /login, /forgot-password, /reset-password, /verify-email live.
# Defaults to the apex (4truck.us) so password-reset and
# email-verification links are role-neutral — a Fleet user clicking
# their reset link doesn't see "dash." in the URL.  The dashboard SPA
# on the apex handles those routes and bounces the user to their
# persona subdomain (fleet./dispatch./safety./dash.) after auth.
#
# Legacy: if AUTH_BASE_URL is unset, DASHBOARD_BASE_URL is honored as
# a fallback so the upgrade is non-breaking.
AUTH_BASE_URL=https://4truck.us

# ── Subdomain layout (production) ───────────────────
# As of the subdomain split, each surface has its own dedicated host:
#   dash.4truck.us  — desktop dashboard (React SPA, served directly by nginx)
#   app.4truck.us   — Telegram Mini App (PWA, served directly by nginx)
#   api.4truck.us   — pure FastAPI for direct integrations
#   bot.4truck.us   — Telegram webhook listener
#
# Apex paths (4truck.us/dashboard/*, /miniapp/*) 301-redirect to the
# new subdomains so existing bookmarks keep working during cutover.
# Telegram setWebhook + @BotFather Mini App URL + Google OAuth redirect
# URI must be updated when these env vars change — see
# docs/runbooks/subdomain-rollout.md for the manual steps.

# URL where the Mini App is served — must be the new subdomain.
# Production: https://app.4truck.us
WEBAPP_URL=

# Telegram webhook public URL — must be the new subdomain.
# Production: https://bot.4truck.us/webhook
# Leave blank to use long polling (bot pulls updates instead of
# Telegram pushing them).
WEBHOOK_URL=

# Google Drive OAuth redirect URI — must be the new API subdomain.
# Production: https://api.4truck.us/storage/google/callback
# (Note: under api.4truck.us the FastAPI /api prefix is stripped at
# nginx, so /api/storage/google/callback becomes /storage/google/callback)
GDRIVE_OAUTH_REDIRECT_URI=

# JWT secret for API auth — REQUIRED.
# Generate with: openssl rand -hex 32
# Stable, never-rotate value: changing it logs out every dashboard/miniapp
# user.  No fallback exists — the API will refuse to boot without this.
JWT_SECRET=

# ── Ports (optional) ────────────────────────────────
# API port (default 8000)
# API_PORT=8000
# Webhook port (default 8001)
# WEBHOOK_PORT=8001

# ── Redis (optional) ────────────────────────────────
# Redis URL for caching. Port 8002 avoids conflict with other projects.
# Set empty to disable Redis and use in-memory fallback.
# REDIS_URL=redis://127.0.0.1:8002/0

# ── Outbound email (required for password reset, email verify,
#    lockout-notice flows; module is a no-op until SMTP is set) ─────
#
# Production uses Resend (https://resend.com) via its SMTP gateway.
# Any provider that speaks SMTP works (SES, SendGrid, Postmark,
# Mailgun) — only the host + credentials change.
#
# IMPORTANT: use port 587 (STARTTLS) with SMTP_USE_TLS=1.  Port 465
# is also supported but requires SMTP_USE_TLS=0 because of a
# different handshake (implicit TLS from connect, no STARTTLS
# upgrade).  Mixing 465 + STARTTLS=1 or 587 + STARTTLS=0 will hang
# the handshake silently.
#
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxxxxxxxxx     # Resend API key — Settings → API Keys
# SMTP_USE_TLS=1
#
# Envelope sender — the address recipients see after "from".  Must
# be on a domain you've verified in Resend (DKIM + SPF records added
# to your DNS).  Deliverability tips:
#   • Use a dedicated subdomain (mail.4truck.us) so transactional
#     reputation stays isolated from any marketing traffic.
#   • A real mailbox (support@, hello@) outperforms "noreply@" with
#     Gmail's reputation scoring.  If you keep noreply@, set
#     SMTP_REPLY_TO below to a monitored mailbox.
# SMTP_FROM=noreply@4truck.us
#
# Display name shown next to the sender address in the recipient's
# inbox.  Defaults to whatever EMAIL_BRAND_NAME is below.  Set only
# when you want a different display in the From line vs. the brand
# name used inside the email body.
# SMTP_FROM_NAME=4truck
#
# Reply-To header — recommended when SMTP_FROM is a no-reply alias.
# SMTP_REPLY_TO=support@4truck.us
#
# Brand name embedded in email subject lines + body text:
#   "Welcome to <EMAIL_BRAND_NAME>!"
#   "<EMAIL_BRAND_NAME>: reset your password"
# Defaults to "4truck" — override only when white-labeling.
# EMAIL_BRAND_NAME=4truck
#
# Dedicated envelope sender for INVITE emails — isolates invite
# sender-domain reputation from auth/alert traffic.  Without this,
# invite emails ship from SMTP_FROM (e.g. noreply@) and a bounce-
# heavy invite blast (operator typos a list) would degrade
# password-reset deliverability for paying customers.  Recommend a
# separate verified sender like invites@4truck.us on the SAME
# domain (no new DKIM/SPF/DMARC work) — Resend, SES, SendGrid all
# treat per-sender reputation independently when From addresses
# differ.  Falls back to SMTP_FROM when unset.
# SMTP_FROM_INVITES=invites@4truck.us
#
# Origin used to build the API URL inside invite emails (for the
# /api/v1/auth/invite/decline link backing the List-Unsubscribe
# header).  Defaults to AUTH_BASE_URL — only set this when your
# deploy has the API on a different host than the dashboard
# (e.g. api.4truck.us vs dash.4truck.us with no reverse proxy).
# API_BASE_URL=https://api.4truck.us
#
# ── Resend HTTP API + bounce/complaint webhooks ──────────────────
# Route invite emails through Resend's HTTPS API instead of plain
# SMTP.  Required for bounce/complaint webhook visibility — Resend
# only fires webhooks for sends made via their API, NOT via their
# SMTP relay.  Auth emails (verify, password reset, lockout) keep
# using SMTP regardless of this setting — they don't need
# webhook-driven state, and one bad invite blast shouldn't tank
# password-reset deliverability through reputation contamination.
#
# Three-step rollout:
#   1. Set MAIL_PROVIDER=resend + RESEND_API_KEY here.  Invite
#      sends switch transport on next request; falls back to SMTP
#      if the API call fails.
#   2. In your Resend dashboard, add a webhook endpoint pointing
#      at https://<your-api-host>/api/v1/webhooks/resend with
#      events email.bounced, email.delivery_delayed,
#      email.complained, email.delivered.  Copy the per-endpoint
#      signing secret into RESEND_WEBHOOK_SECRET below.
#   3. Test by sending an invite to a known-bouncing address
#      (e.g. bounced@simulator.resend.dev).  The webhook should
#      flip the row to a 'Bounced' badge within a few seconds.
# MAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxx
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxx
