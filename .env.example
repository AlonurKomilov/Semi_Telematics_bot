# ─────────────────────────────────────────────────
#  Semi Telematics Bot — Environment Configuration
# ─────────────────────────────────────────────────
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
#
#  Bot infrastructure ONLY. NO customer data here.
#  All customer accounts, orgs, Samsara API keys,
#  and users are managed via bot commands (/register,
#  /addorg, /invite) and stored in the database.
# ─────────────────────────────────────────────────

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# System Owners — platform administrators (NOT customers)
# Comma-separated Telegram IDs. These users see /admin panel,
# bot-wide analytics, account management. NOT stored in DB.
SYSTEM_OWNER_IDS=123456789

# Support contact — shown to new/unregistered users
SUPPORT_CONTACT=@YourSupportHandle

# Database path (SQLite — future: swap to PostgreSQL URL for Option B)
DATABASE_PATH=data/bot.db

# Samsara API base URL
SAMSARA_BASE_URL=https://api.samsara.com

# Alert Configuration
# How often (in minutes) to check for new faults and send alerts
ALERT_CHECK_INTERVAL_MINUTES=30

# Fuel level threshold (%) — trucks below this trigger a low-fuel warning
FUEL_LOW_THRESHOLD_PERCENT=20
