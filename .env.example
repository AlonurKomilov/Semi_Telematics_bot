# ─────────────────────────────────────────────────
#  Semi Telematics Bot — Environment Configuration
# ─────────────────────────────────────────────────
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
# ─────────────────────────────────────────────────

# Telegram Bot Configuration
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# System Owner — platform administrator (NOT a customer)
# These Telegram IDs get access to /admin panel, bot-wide analytics,
# account management, etc. Comma-separated. NOT stored in the database.
SYSTEM_OWNER_IDS=123456789

# Support contact — shown to new users on the welcome screen
SUPPORT_CONTACT=@YourSupportHandle

# Database path (SQLite — future: swap to PostgreSQL URL for Option B)
DATABASE_PATH=data/bot.db

# Samsara API base URL
SAMSARA_BASE_URL=https://api.samsara.com

# Alert Configuration
# How often (in minutes) to check for new faults and send alerts
ALERT_CHECK_INTERVAL_MINUTES=30

# Fuel level threshold (%) — trucks below this trigger a low-fuel warning
FUEL_LOW_THRESHOLD_PERCENT=20

# ─── First-Run Seed Data (optional) ─────────────────────────────
# These values are used ONCE on first startup to populate the database.
# After the first run, all configuration is managed via bot commands.
# You can safely remove these after the initial seed.

# Account name for the seed account
ACCOUNT_NAME=My Company

# Users to register as owners on first run (comma-separated Telegram IDs)
TELEGRAM_CHAT_IDS=123456789,987654321

# Samsara orgs to connect on first run
# Format: CODE:api_key,CODE:api_key,...
# Generate API tokens at https://cloud.samsara.com/settings/api-tokens
SAMSARA_ORGS=PTG:samsara_api_your_key_1,CFT:samsara_api_your_key_2

# GPS activity filter for seed orgs (days)
# Filters out sold/decommissioned trucks. 0 = show all
ACTIVE_VEHICLE_GPS_DAYS=30
