# ─────────────────────────────────────────────────
#  Semi Telematics Bot — Environment Configuration
# ─────────────────────────────────────────────────
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
# ─────────────────────────────────────────────────

# Telegram Bot Configuration
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated list of authorized Telegram chat IDs
# Users / groups that can interact with the bot
TELEGRAM_CHAT_IDS=123456789,987654321

# Samsara API Configuration
# Generate an API token at https://cloud.samsara.com/settings/api-tokens
SAMSARA_API_KEY=samsara_api_your_key_here
SAMSARA_BASE_URL=https://api.samsara.com

# Alert Configuration
# How often (in minutes) to check for new faults and send alerts
ALERT_CHECK_INTERVAL_MINUTES=30

# Fuel level threshold (%) — trucks below this trigger a low-fuel warning
FUEL_LOW_THRESHOLD_PERCENT=20
