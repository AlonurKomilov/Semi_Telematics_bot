.env
__pycache__/
*.pyc
*.pyo
*.db
*.db-shm
*.db-wal
*.sqlite3
data/
backups/
.venv/
venv/
env/
*.log
.bot.pid
.pid
.pytest_cache/
.mypy_cache/
.ruff_cache/
=*

# Build outputs
interfaces/dashboard/dist/
interfaces/miniapp/dist/
interfaces/system_dashboard/dist/
node_modules/
*.tar.gz

# Google Cloud service account keys — NEVER commit
*.json
!package.json
!package-lock.json
!tsconfig.json
!locales/*.json
# Nested locale folders (dashboard + miniapp i18n) — same intent as
# top-level locales/, just at the actual location the apps use.
!interfaces/dashboard/src/locales/*.json
!interfaces/miniapp/src/locales/*.json
!interfaces/system_dashboard/src/locales/*.json
# shadcn-ui config (no secrets, just component path mappings)
!interfaces/dashboard/components.json
!interfaces/system_dashboard/components.json
# Grafana dashboards — infrastructure-as-code, must travel with the repo
!docs/grafana/*.json
!observability/grafana/dashboards/*.json
!pytest.ini

# Old backup files from refactoring
_*_old.py
bot/_*_old.py

# Local docs scratch: reference material (Vertex AI Model Garden
# catalog snapshots, architecture sketches, drafts) lives under
# docs/ but mostly shouldn't pollute git status.  Files already
# tracked under docs/runbooks/ stay tracked — gitignore only
# affects NEW untracked files.  New runbooks worth committing
# should be added explicitly with `git add -f docs/runbooks/<name>`.
docs/
!docs/runbooks/
!docs/runbooks/**/*.md
!docs/grafana/
!docs/grafana/*.json
