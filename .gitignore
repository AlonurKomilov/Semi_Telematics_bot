.env
__pycache__/
*.pyc
*.pyo
*.db
*.db-shm
*.db-wal
*.sqlite3
# Repo-root /data only — matches the dev fixtures dir at the project
# root, not nested source folders like
# interfaces/dashboard/src/data/ which legitimately ships TS code.
/data/
/backups/
.venv/
venv/
env/
*.log
.bot.pid
.deps-installed
.env-applied
.sudo-owned
.pid
.pytest_cache/
.mypy_cache/
.ruff_cache/
=*

# Build outputs
interfaces/dashboard/dist/
interfaces/miniapp/dist/
interfaces/system_dashboard/dist/
node_modules/
*.tar.gz

# Google Cloud service account keys — NEVER commit
*.json
!package.json
!package-lock.json
!tsconfig.json
!locales/*.json
# Nested locale folders (dashboard + miniapp i18n) — same intent as
# top-level locales/, just at the actual location the apps use.
!interfaces/dashboard/src/locales/*.json
!interfaces/miniapp/src/locales/*.json
!interfaces/system_dashboard/src/locales/*.json
# shadcn-ui config (no secrets, just component path mappings)
!interfaces/dashboard/components.json
!interfaces/system_dashboard/components.json
# Grafana dashboards — infrastructure-as-code, must travel with the repo
!docs/grafana/*.json
!observability/grafana/dashboards/*.json
!pytest.ini

# Old backup files from refactoring
_*_old.py
bot/_*_old.py

# Local docs scratch: reference material (Vertex AI Model Garden
# catalog snapshots, architecture sketches, drafts) lives under
# docs/ but mostly shouldn't pollute git status.  ``docs/*`` (not
# ``docs/``) on purpose: git cannot re-include below an excluded
# parent directory, so the whole-dir form silently broke every
# ``!docs/...`` exception (new runbooks needed a manual
# ``git add -f``).  With the children-only form the re-includes work.
docs/*
!docs/runbooks/
!docs/grafana/
# Architecture decision docs — SSOT plans, must travel with the repo.
!docs/architecture/
# The two taxonomy SSOTs are maintained docs, not working papers — the
# docs/* wildcard above had kept them invisible to the repo for months.
!docs/FEATURES.md
!docs/SERVICES.md
# UX psychology audit reports stay LOCAL-ONLY (docs/* already ignores
# them): they are point-in-time working papers, not source.  The
# ux-audit-psychology skill still writes them here and aggregates them
# across sessions from disk — they just never enter git.

# abc-lab (the skills-family workspace): harness CODE is tracked and
# reviewed like any code; anything runtime- or secret-shaped never is.
# Belt-and-braces over each harness's own .gitignore, so a future
# harness that forgets to write one still cannot leak.
abc-lab/**/*.log
abc-lab/**/.env
abc-lab/**/.env.*
abc-lab/**/*.pem
abc-lab/**/*.key
abc-lab/**/id_rsa*
abc-lab/**/id_ed25519*
abc-lab/**/*token*.txt
abc-lab/**/*secret*
abc-lab/**/node_modules/
abc-lab/**/objstore/
abc-lab/**/dist*/
