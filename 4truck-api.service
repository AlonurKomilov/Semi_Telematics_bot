[Unit]
Description=4truck API Server
After=network-online.target 4truck-bot.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=abcdev
Group=abcdev
WorkingDirectory=/home/abcdev/projects/Semi_Telematics_bot
ExecStart=/usr/bin/python3 /home/abcdev/projects/Semi_Telematics_bot/run.py
Restart=always
RestartSec=5
TimeoutStopSec=10
StandardOutput=append:/home/abcdev/projects/Semi_Telematics_bot/api.log
StandardError=append:/home/abcdev/projects/Semi_Telematics_bot/api.log
EnvironmentFile=/home/abcdev/projects/Semi_Telematics_bot/.env
Environment=ENABLE_API=1
Environment=ENABLE_BOT=0
Environment=ENABLE_SCHEDULER=0

[Install]
WantedBy=multi-user.target
