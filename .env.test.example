# ═══════════════════════════════════════════════════════════════════
#  TEST ENVIRONMENT — sandbox keys, test bots, a test database.
#
#  This is NOT the file the API runs from.  `make restart` and
#  `rolling_restart.sh` load `.env` and nothing else.  Copy this to
#  `.env.test` (gitignored) and fill it with the values of the TEST
#  side of every service: Stripe's sandbox, a test Telegram bot, a
#  test database.  Then:
#
#      BILLING_PREFLIGHT_ENV=.env.test ./scripts/billing_preflight.sh
#      make preflight-test                       (the same, shorter)
#
#  checks that the test configuration is whole — read-only, touches
#  nothing.  Running the API itself against this file needs a STAGING
#  server: its own database (DATABASE_URL below — never the live one,
#  the plan rows there hold LIVE Stripe Price ids, and a test key
#  cannot use them) and its own hosts.
#
#  Why the word TEST is everywhere here: a value copied out of this
#  file into `.env` by mistake must be recognisable at a glance.  The
#  console says "Stripe TEST mode" whenever the key is sk_test_…, and
#  the preflight warns the same way — read both before a deploy.
# ═══════════════════════════════════════════════════════════════════

# ── Billing: Stripe SANDBOX ("4truck sandbox" under ABC LEGACY LLC) ──
BILLING_PROVIDER=stripe
# sk_test_… — the sandbox's secret key.  Never sk_live_ in this file.
STRIPE_SECRET_KEY=
# whsec_… of the SANDBOX webhook endpoint (/billing/stripe/webhook).
# Endpoints and their secrets are per mode; the live one is different.
STRIPE_WEBHOOK_SECRET=
# LEGACY, optional: the env-wide per-extra-truck Price.  Each plan makes
# its own extras Price on save now; set this only while subscriptions
# made before that still exist, so the rollout can recognise them.
STRIPE_PRICE_EXTRA_VEHICLE=

# ── Database: a TEST database.  Never the live one (see the header). ──
DATABASE_URL=

# ── Telegram: TEST bots (register separate bots with @BotFather) ──
TELEGRAM_SYSTEM_BOT_TOKEN=
TELEGRAM_LOGIN_BOT_TOKEN=
# the operators of the test platform — usually the same ids as live
SYSTEM_OWNER_IDS=
SUPPORT_CONTACT=

# ── Hosts of the test deployment (a staging server, or localhost) ──
DASHBOARD_BASE_URL=
AUTH_BASE_URL=
WEBAPP_URL=
WEBHOOK_URL=

# ── Secrets of the test deployment — DIFFERENT from live ──
# A JWT_SECRET shared with live would let a test-minted token open the
# live API; an ENCRYPTION_KEY shared with live would read live rows.
JWT_SECRET=
ENCRYPTION_KEY=

# ── Integrations: the test side of each ──
# Samsara has no sandbox; a test deployment either points at a test
# org's token (entered per account, not here) or leaves ingest off.
SAMSARA_BASE_URL=
DATATRUCK_BASE_URL=
DATATRUCK_API_TOKEN=
GDRIVE_OAUTH_CLIENT_ID=
GDRIVE_OAUTH_CLIENT_SECRET=
GDRIVE_OAUTH_REDIRECT_URI=
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# ── Turnstile: Cloudflare's published TEST pair — every challenge passes ──
# site key    1x00000000000000000000AA
# secret key  1x0000000000000000000000000000000AA
# (written as comments: the commit guard cannot tell a published test
#  key from a real one, and a template holds names, not values)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Email: a test sender, or leave empty to send nothing ──
SALES_EMAIL=
